# Copiar este archivo como .env (en la misma carpeta) y completar los valores.
# .env está en .gitignore: nunca se sube a GitHub. Este ejemplo sí se sube, sin valores.

# Token que el servidor exige en cada pedido.
# Generarlo una sola vez con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PSI_API_TOKEN=

# Orígenes del navegador que pueden llamar al servidor (separados por coma).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
