{
  "name": "PsiEstudio",
  "short_name": "PsiEstudio",
  "description": "Plataforma de gestión académica, protocolo de clases, ingestión de PDFs y sincronización offline con Supabase.",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#FBF8F3",
  "theme_color": "#10B981",
  "orientation": "portrait",
  "icons": [
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    }
  ],
  "share_target": {
    "action": "./index.html?shared=true",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": ["application/pdf", "image/*", "audio/*", "text/*"]
        }
      ]
    }
  }
}
